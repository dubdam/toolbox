{
	"name": "toolbox",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"start": "bun ./start.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test src",
		"autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
		"autostart:off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-startup.ps1"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.46.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@bytemd/plugin-gfm": "^1.22.0",
		"@bytemd/plugin-highlight": "^1.22.0",
		"@noble/hashes": "^2.4.0",
		"bytemd": "^1.22.0",
		"exifr": "^7.1.3",
		"github-markdown-css": "^5.9.0",
		"highlight.js": "^11.12.0",
		"jsqr": "^1.4.0",
		"openai": "^7.15.0",
		"sharp": "^0.35.4",
		"uqr": "^0.1.3",
		"zod": "^4.6.5"
	}
}
